{
  "name": "codenodemap",
  "displayName": "Code Node Map",
  "description": "Code Node Map (codenodemap): hierarchical source-code node graph viewer with Markdown nodes, explicit layout, depth-based LOD, role colors, tags, and source links.",
  "version": "0.3.52",
  "publisher": "wangyifu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:codenodemap.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codenodemap.open",
        "title": "Code Node Map: Open"
      }
    ],
    "configuration": {
      "title": "Code Node Map",
      "properties": {
        "codenodemap.file": {
          "type": "string",
          "default": "",
          "description": "工作区内的 codemap JSON 路径。留空则自动搜索或选择文件。"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "codenodemap.open",
          "when": "resourceExtname == .json",
          "group": "navigation@99"
        }
      ]
    }
  },
  "files": [
    "extension.js",
    "media/**",
    "README.md",
    "LICENSE"
  ],
  "author": "wangyifu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luna1996/code-node-map.git"
  },
  "homepage": "https://github.com/Luna1996/code-node-map#readme",
  "bugs": {
    "url": "https://github.com/Luna1996/code-node-map/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b0e14",
    "theme": "dark"
  },
  "keywords": [
    "codenodemap",
    "code node map",
    "code graph",
    "node graph",
    "flowchart",
    "diagram",
    "visualization",
    "architecture",
    "source code",
    "llama.cpp"
  ]
}
